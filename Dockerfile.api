# =============================================================================
# FastAPI Application Dockerfile (Lightweight)
# =============================================================================
#
# API service for querying - does NOT need:
# - sentence-transformers (embeddings done in Airflow)
# - torch/nvidia (embeddings done in Airflow)
# - storage package (file operations done in Airflow)
#
# API DOES need:
# - FastAPI, uvicorn, httpx, openai
# - chromadb (client only, for querying)
# - psycopg (database queries)
# - pydantic

FROM python:3.12-slim AS base

WORKDIR /opt/app

# Install curl for healthcheck
RUN apt-get update && apt-get install -y --no-install-recommends curl && \
    rm -rf /var/lib/apt/lists/*

# Install uv for fast package installation
COPY --from=ghcr.io/astral-sh/uv:latest /uv /usr/local/bin/uv

# =============================================================================
# Dependencies stage - install only what API needs
# =============================================================================
FROM base AS deps

# Copy only the packages API needs
COPY packages/utils/pyproject.toml packages/utils/
COPY packages/utils/src packages/utils/src
COPY packages/db/pyproject.toml packages/db/
COPY packages/db/src packages/db/src
COPY packages/vectordb/pyproject.toml packages/vectordb/
COPY packages/vectordb/src packages/vectordb/src
COPY packages/api/pyproject.toml packages/api/
COPY packages/api/src packages/api/src

# Install packages
# NOTE: sentence-transformers needed because ChromaDB collection uses it for embeddings
RUN uv pip install --system \
    -e packages/utils \
    -e packages/db \
    -e packages/vectordb \
    -e packages/api \
    && uv pip install --system torch --index-url https://download.pytorch.org/whl/cpu \
    && uv pip install --system sentence-transformers

# =============================================================================
# Runtime stage
# =============================================================================
FROM base AS runtime

# Copy installed packages from deps stage
COPY --from=deps /usr/local/lib/python3.12/site-packages /usr/local/lib/python3.12/site-packages
COPY --from=deps /usr/local/bin /usr/local/bin

# Copy source packages
COPY packages/utils /opt/app/packages/utils
COPY packages/db /opt/app/packages/db
COPY packages/vectordb /opt/app/packages/vectordb
COPY packages/api /opt/app/packages/api

# Copy DAGs (for file_records helpers)
COPY dags /opt/app/dags

# Add dags to Python path
ENV PYTHONPATH="/opt/app/dags:${PYTHONPATH}"

# Create non-root user
RUN useradd -m -u 1000 appuser
USER appuser

EXPOSE 8000

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=10s --retries=3 \
    CMD curl --fail http://localhost:8000/health || exit 1

# Run uvicorn
CMD ["uvicorn", "api.main:app", "--host", "0.0.0.0", "--port", "8000"]
