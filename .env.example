# =============================================================================
# Airflow Template Environment Configuration
# =============================================================================
# Copy this file to .env and fill in the values:
#   cp .env.example .env
#
# For local development with docker-compose, the default values work out of box.
# For production, you MUST change the secret keys and database URLs.
# =============================================================================

# -----------------------------------------------------------------------------
# Application Settings
# -----------------------------------------------------------------------------

# Application mode: "development" or "production"
# - development: colorized console logs, relaxed settings
# - production: Airflow-compatible structured logs
APP_MODE=development

# Log level: DEBUG, INFO, WARNING, ERROR, or "silent"
LOG_LEVEL=INFO

# -----------------------------------------------------------------------------
# Database Configuration
# -----------------------------------------------------------------------------

# Application database (YOUR data - models, business logic)
# Format: postgresql+psycopg://user:password@host:port/database
# NOTE: Use postgresql+psycopg:// (psycopg3), NOT postgresql:// (psycopg2)
DATABASE_URL=postgresql+psycopg://app:app@postgres:5432/app

# Airflow metadata database (DAG runs, task instances, logs)
# This MUST be separate from your application database
AIRFLOW_DATABASE_URL=postgresql+psycopg://airflow:airflow@postgres:5432/airflow

# -----------------------------------------------------------------------------
# Airflow Security
# -----------------------------------------------------------------------------

# Secret key for API server and JWT authentication
# IMPORTANT: Generate a secure random key for production!
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
AIRFLOW_SECRET_KEY=change-me-in-production-use-secrets-token-urlsafe

# Admin username for Airflow UI (password is auto-generated on first run)
# Check logs or simple_auth_manager_passwords.json.generated for the password
AIRFLOW_ADMIN_USER=admin

# -----------------------------------------------------------------------------
# Docker Configuration
# -----------------------------------------------------------------------------

# User ID for Airflow container (must match host directory ownership)
# Run `id -u` to get your user ID
# Default 50000 is the airflow user in the official image
AIRFLOW_UID=50000

# -----------------------------------------------------------------------------
# Optional: External Services (uncomment and configure as needed)
# -----------------------------------------------------------------------------

# # PostgreSQL on external host (instead of docker-compose postgres)
# DATABASE_URL=postgresql+psycopg://user:password@your-rds-host.amazonaws.com:5432/app?sslmode=require
# AIRFLOW_DATABASE_URL=postgresql+psycopg://user:password@your-rds-host.amazonaws.com:5432/airflow?sslmode=require

# # API Keys for LLM providers (if your DAGs use them)
# ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...
